#!/bin/sh
# chezmoi modify_ スクリプト → ~/.claude/settings.json
#
# このファイルは Claude Code 自身と外部ツールのインストーラが実行時に書き込むため、丸ごと管理すると
# 必ず衝突する。repo が真とするキーだけを上書きし、それ以外は実ファイルの値を素通しする。
#
# 実ファイルの値を素通しするキー:
#   autoMode                ... auto mode が学習した環境情報。社内情報を含むため
#                               この公開リポジトリには絶対に入れない
#   hooks                   ... 外部ツールのインストーラが管理するため触らない
#   permissions.defaultMode ... auto mode のオプトイン結果
#   （将来 Claude Code が追記する未知のキーもすべて保持される）
#
# 変更するときはこのスクリプト内の MANAGED_JSON を編集すること。
# chezmoi re-add は使わない（実ファイルの社内情報が repo に入る）。

set -eu

managed=$(cat <<'MANAGED_JSON'
{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "WebSearch(*)",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(tsc *)",
      "Bash(ghq *)",
      "Bash(which *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(sleep *)",
      "Bash(cat *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/.docker/**)",
      "Edit(~/.docker/**)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(**/.envrc)",
      "Edit(**/.envrc)",
      "Read(**/credentials.json)",
      "Edit(**/credentials.json)",
      "Read(**/credentials.yaml)",
      "Edit(**/credentials.yaml)",
      "Read(**/secrets.json)",
      "Edit(**/secrets.json)",
      "Read(**/secrets.yaml)",
      "Edit(**/secrets.yaml)",
      "Read(**/*api_key*)",
      "Edit(**/*api_key*)",
      "Read(**/*apikey*)",
      "Edit(**/*apikey*)",
      "Read(**/*secret*)",
      "Edit(**/*secret*)",
      "Read(**/*token*)",
      "Edit(**/*token*)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Read(~/.pypirc)",
      "Edit(~/.pypirc)",
      "Read(//etc/**)",
      "Edit(//etc/**)",
      "Read(//usr/**)",
      "Edit(//usr/**)",
      "Read(/var/**)",
      "Edit(/var/**)",
      "Read(//System/**)",
      "Edit(//System/**)",
      "Read(//Library/**)",
      "Edit(//Library/**)",
      "Read(//Applications/**)",
      "Edit(//Applications/**)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)"
    ]
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "codebase-design": "off",
    "find-skills": "off",
    "pr-drawio": "off",
    "domain-modeling": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "codex@openai-codex": false,
    "crit@crit": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
MANAGED_JSON
)

existing=$(cat)
[ -n "$existing" ] || existing='{}'

jq=$(command -v jq 2>/dev/null || true)
if [ -z "$jq" ]; then
  # jq が無い環境では実ファイルを壊さない。新規作成時のみ管理側をそのまま書く。
  if [ "$existing" = '{}' ]; then
    printf '%s\n' "$managed"
  else
    printf '%s' "$existing"
    echo "modify_settings.json: jq が無いため既存の設定をそのまま維持しました" >&2
  fi
  exit 0
fi

# 実ファイル(stdin)を土台に、管理対象キーだけを上書きする。
# permissions は allow/deny だけ差し替え、defaultMode 等は実ファイルの値を残す。
printf '%s' "$existing" | "$jq" --argjson m "$managed" '
  . as $cur
  | $cur
  + ($m | del(.permissions))
  + { permissions: (($cur.permissions // {}) + ($m.permissions // {})) }
'
